{
  "name": "aps-viewer-sandbox",
  "version": "1.0.0",
  "description": "Autodesk Platform Services application built by following the Simple Viewer tutorial from https://aps.autodesk.com/tutorials.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:vendor": "node scripts/sync-vendor.mjs",
    "prestart": "npm run build:vendor",
    "pretest": "npm run build:vendor",
    "postinstall": "patch-package --error-on-fail",
    "test": "npm run test:offline && npm run test:clashpanel:dom",
    "test:offline": "node scripts/run-tests.mjs",
    "test:clashpanel:dom": "node scripts/run-dom-tests.mjs",
    "test:g2:binding": "node --test test/acceptance/clashpanel-viewerbridge.acceptance.binding.mjs",
    "test:acceptance": "node test/acceptance/room-locator.acceptance.mjs",
    "test:acceptance:clash-finder": "node test/acceptance/clash-finder.acceptance.mjs",
    "test:performance:gate": "node test/performance/run-gate.mjs",
    "test:performance:gate:m2": "node test/performance/run-gate-m2.mjs",
    "test:performance:gate:m3": "node test/performance/run-gate-m3.mjs",
    "test:performance:gate:m4": "node test/performance/run-gate-m4.mjs",
    "test:regression:swap-replay": "node test/performance/m4/operand-swap-replay.mjs",
    "test:regression:arm-order": "node test/performance/m4/arm-order-independence.mjs",
    "test:regression:blocker-reload": "node test/performance/m4/hard-clash-precheck-blocker-reload.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aps",
    "autodesk-platform-services",
    "aps-viewer",
    "forge-viewer"
  ],
  "license": "MIT",
  "dependencies": {
    "@aps_sdk/authentication": "^1.0.1",
    "@aps_sdk/model-derivative": "^1.2.1",
    "@aps_sdk/oss": "^1.3.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "@types/forge-viewer": "*",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1"
  }
}
